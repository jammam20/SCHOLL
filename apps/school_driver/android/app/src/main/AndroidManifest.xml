<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Live trip tracking (DriverTrackingRepository / geolocator). Fine +
         coarse are required for any GPS fix at all — previously missing
         from this manifest entirely, meaning Geolocator.requestPermission()
         could never actually be granted on a real device, since Android
         will not grant a runtime permission that isn't declared here.
         FOREGROUND_SERVICE(+_LOCATION) are required to run geolocator's own
         bundled GeolocatorLocationService (declared in the geolocator_android
         plugin's manifest, auto-merged into this app) as a real foreground
         service — see AndroidSettings.foregroundNotificationConfig in
         driver_tracking_repository.dart. ACCESS_BACKGROUND_LOCATION is
         deliberately NOT requested: Android treats an app running a
         genuine foreground service as active foreground usage for location
         purposes, so it isn't required for this pattern, and requesting it
         would only add an unnecessary permission prompt. POST_NOTIFICATIONS
         (needed to show the foreground service's persistent notification on
         Android 13+) is already declared by firebase_messaging's own
         manifest, which this app already depends on. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <application
        android:label="Jammam Driver"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- Required by google_maps_flutter (the driver's today's-pickup-order
             map). The real value is injected at build time from
             android/local.properties' MAPS_API_KEY (see build.gradle.kts and
             README.md) — never hardcoded here, so it's never committed. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
