rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSystemAdmin() {
      return signedIn() &&
          exists(/databases/$(database)/documents/systemAdmins/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/systemAdmins/$(request.auth.uid)).data.isActive == true;
    }

    function membership(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid));
    }

    function isActiveMember(schoolId) {
      return signedIn() &&
          exists(/databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid)) &&
          membership(schoolId).data.isActive == true &&
          membership(schoolId).data.status == 'approved';
    }

    function isSchoolAdmin(schoolId) {
      return isActiveMember(schoolId) &&
          membership(schoolId).data.role == 'admin';
    }

    // Read-only operational role (Feature: School Staff/Teacher) — never
    // treated as a subset of isSchoolAdmin anywhere in these rules; every
    // grant staff gets is spelled out explicitly as its own `|| isSchoolStaff(...)`
    // clause on read-only rules, and staff never appears in a write rule.
    function isSchoolStaff(schoolId) {
      return isActiveMember(schoolId) &&
          membership(schoolId).data.role == 'staff';
    }

    // A driver needs their route's full student roster (pickup points,
    // absence flags) the moment a trip starts, to build the stop order and
    // manifest (StopOrderRepository.computeInitialOrder, StopOrderView) —
    // rules can't cheaply check "is this driver assigned to *this specific*
    // student's route" without a query, so this trusts any approved, active
    // driver of the school with its whole roster, the same trust level
    // isSchoolStaff already gets. Scoped to this one school only.
    function isSchoolDriver(schoolId) {
      return isActiveMember(schoolId) &&
          membership(schoolId).data.role == 'driver';
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // A brand-new parent, driver or admin registers by writing these two
    // documents directly (see FirebaseAuthRepository.registerParent/
    // registerDriver/registerAdmin in the parent/driver/admin apps) instead
    // of through a Cloud Function — this project doesn't require every
    // deployment to be on the Blaze plan just to let someone sign up.
    // `create` is scoped tightly to a self-service request: a client can
    // never grant itself an approved/active status, or write a doc for a
    // different uid. A self-served 'admin' request is genuinely harmless
    // even though the role name looks dangerous — every actual admin
    // capability elsewhere in these rules requires status == 'approved',
    // and only an *existing* school admin or a system admin can flip that
    // (see the `members/{uid}` update rule) — a system admin necessarily,
    // for a brand-new school with no admin yet. The pending/not-approved
    // state itself is checked per-collection just below (`users` docs carry
    // `approved`+`membershipStatus`, `members` docs carry only `status` —
    // there's no shared `approved` field between the two, so that check
    // can't live in this shared helper).
    function isSelfServeRole(role) {
      return role == 'parent' || role == 'driver' || role == 'admin' || role == 'staff';
    }

    // Mirrors TRIP_STATUS_TRANSITIONS in functions/src/index.ts (dormant —
    // Cloud Functions need the Blaze plan) and TripStatus.canTransitionTo in
    // packages/school_shared/lib/src/enums/trip_status.dart — keep all
    // three in sync if the state machine changes. Re-implemented here so
    // the assigned driver can progress a trip's status with a direct write
    // instead of going through that undeployed callable.
    function isValidTripTransition(current, next) {
      return (current == 'scheduled' && (next == 'starting' || next == 'cancelled')) ||
          (current == 'starting' && (next == 'active' || next == 'cancelled')) ||
          (current == 'active' && (next == 'paused' || next == 'completed' || next == 'emergency')) ||
          (current == 'paused' && (next == 'active' || next == 'cancelled' || next == 'emergency')) ||
          (current == 'emergency' && (next == 'completed' || next == 'cancelled'));
    }

    // Feature: school location must be set first. A school's own location
    // (schools/{schoolId}.latitude/longitude) is every trip's fixed
    // endpoint — creating operational geography (routes, pickup points)
    // before it exists would leave that endpoint undefined, so those
    // `create` rules gate on it directly instead of trusting the client to
    // have checked first.
    function schoolHasLocation(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)).data.latitude is number &&
          get(/databases/$(database)/documents/schools/$(schoolId)).data.longitude is number;
    }

    // Feature: driver trip start window. `tripStartWindowMinutes` is a
    // school-wide setting (schools/{schoolId}.tripStartWindowMinutes); null/
    // unset means "not configured", which keeps every existing school's
    // current behavior (start any time) unchanged.
    function isWithinTripStartWindow(schoolId, scheduledAt) {
      let windowMinutes = get(/databases/$(database)/documents/schools/$(schoolId)).data.get('tripStartWindowMinutes', null);
      return windowMinutes == null ||
          request.time >= scheduledAt - duration.value(windowMinutes, 'm');
    }

    // Feature: absence cutoff. Computed against the student's route's fixed
    // daily outbound schedule (SchoolRoute.outboundScheduledMinutes — "today's
    // trip" can't be looked up by a security rule without a query, but a
    // route's own recurring schedule can be `get()` directly) rather than a
    // specific trip document. `outboundScheduledMinutes` is stored as
    // minutes since UTC midnight precisely so it lines up with
    // `request.time.date()` below, which is always UTC midnight — see the
    // model's own doc comment for the local-time-at-save-time convention
    // this depends on. Either setting left unconfigured (null) means no
    // cutoff, matching every route/school that predates this feature.
    function isBeforeAbsenceCutoff(schoolId, routeId) {
      let cutoffMinutes = get(/databases/$(database)/documents/schools/$(schoolId)).data.get('absenceCutoffMinutes', null);
      let routeExists = routeId is string && routeId != '' &&
          exists(/databases/$(database)/documents/schools/$(schoolId)/routes/$(routeId));
      let scheduledMinutes = routeExists ?
          get(/databases/$(database)/documents/schools/$(schoolId)/routes/$(routeId)).data.get('outboundScheduledMinutes', null) :
          null;
      return cutoffMinutes == null || scheduledMinutes == null ||
          request.time <= request.time.date() +
              duration.value(scheduledMinutes, 'm') -
              duration.value(cutoffMinutes, 'm');
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isSystemAdmin();
      allow create: if isSelf(uid) &&
          request.resource.data.uid == uid &&
          isSelfServeRole(request.resource.data.role) &&
          request.resource.data.approved == false &&
          request.resource.data.membershipStatus == 'pending';
      // A user updates their own notification preferences (see
      // NotificationPrefsRepository) or display name (ProfileRepository) —
      // restricted to just those fields so this can't also touch
      // role/schoolId/approved.
      allow update: if isSelf(uid) &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['notificationPrefs', 'name', 'updatedAt']);
      allow delete: if false;

      // In-app notification inbox (Feature: Smart Notifications) — written
      // only by the onTripStatusChanged/onDriverLocationWritten Cloud
      // Functions via the Admin SDK (which bypasses these rules entirely),
      // at the same moment they send the matching FCM push. A client can
      // never create/delete an entry; the owning user may only flip `read`.
      match /notifications/{notificationId} {
        allow read: if isSelf(uid);
        allow create, delete: if false;
        allow update: if isSelf(uid) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      }
    }

    match /systemAdmins/{uid} {
      allow read: if isSelf(uid) || isSystemAdmin();
      allow write: if false;
    }

    // A nested rule (see `members/{uid}` under `schools/{schoolId}` below)
    // only ever covers a query/read scoped to *one* specific school —
    // Firestore treats a cross-school `collectionGroup('members')` query
    // (SuperAdminRepository.watchPendingAdmins in the school_super_admin
    // app) as a *collection group* read, which needs its own separate rule
    // matched with the `{path=**}` wildcard, or it's silently denied (shows
    // up client-side as an empty result, not an error). Read-only and
    // system-admin-only — writes still go through the nested rule below.
    match /{path=**}/members/{uid} {
      allow read: if isSystemAdmin();
    }

    // An emergency lives nested under the trip it was raised on
    // (schools/{schoolId}/trips/{tripId}/emergencies/{emergencyId} — see
    // the nested rule under `trips/{tripId}` below, which governs
    // create/update). The admin app's cross-trip history/monitoring view
    // (EmergenciesRepository.watchEmergencies) needs every emergency in
    // its school regardless of which trip it's nested under, which
    // Firestore only exposes via a `collectionGroup('emergencies')`
    // query — exactly like the `members` collection-group read above,
    // that requires its own wildcard-matched rule or it's silently
    // denied. Read-only: writes still go through the nested rule below.
    match /{path=**}/emergencies/{emergencyId} {
      allow read: if isSchoolAdmin(resource.data.schoolId) || isSystemAdmin() ||
          isSchoolStaff(resource.data.schoolId) ||
          (isActiveMember(resource.data.schoolId) &&
              resource.data.driverId == request.auth.uid);
    }

    // Same collection-group requirement as `emergencies` above —
    // PickupVerificationsRepository.watchVerifications (admin analytics)
    // reads across every trip in the school via `collectionGroup
    // ('pickupVerifications')`, which Firestore treats as a distinct read
    // surface from the nested `trips/{tripId}/pickupVerifications/{id}`
    // rule below (that one still governs create). Admin/staff-only here —
    // the narrower per-driver/per-parent case is exactly what the nested
    // rule (and single-trip reads) already cover.
    match /{path=**}/pickupVerifications/{verificationId} {
      allow read: if isSchoolAdmin(resource.data.schoolId) || isSystemAdmin() ||
          isSchoolStaff(resource.data.schoolId);
    }

    // Codes aren't secret-sensitive (worst case of a guessed code is a
    // pending, unapproved membership request — see isSelfServeRole above),
    // so any signed-in user can look one up to self-register. Only a system
    // admin creates them (see the Super Admin panel's "create school" flow
    // in the admin app).
    match /schoolJoinCodes/{code} {
      allow read: if signedIn();
      allow write: if isSystemAdmin();
    }

    match /schools/{schoolId} {
      allow read: if isActiveMember(schoolId) || isSystemAdmin();
      allow create, delete: if isSystemAdmin();
      // A school admin sets their own school's location (every trip's
      // final stop) directly (see SchoolsRepository.updateLocation) —
      // restricted to just those fields so it can't also touch isActive,
      // the name, or the code.
      allow update: if isSystemAdmin() ||
          (isSchoolAdmin(schoolId) &&
              request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['latitude', 'longitude', 'updatedAt']));
      // A school admin configures operational settings — trip start
      // window, absence cutoff, weekly/special holidays (Features: driver
      // trip start window, absence cutoff, school calendar) — kept as its
      // own rule, separate from the location update above, so each stays
      // independently scoped the same way the students rules do.
      allow update: if isSystemAdmin() ||
          (isSchoolAdmin(schoolId) &&
              request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly([
                    'tripStartWindowMinutes', 'absenceCutoffMinutes',
                    'weeklyHolidays', 'specialHolidays', 'updatedAt'
                  ]));

      match /members/{uid} {
        allow read: if isSelf(uid) || isSchoolAdmin(schoolId) || isSystemAdmin();
        allow create: if isSelf(uid) &&
            request.resource.data.uid == uid &&
            request.resource.data.schoolId == schoolId &&
            isSelfServeRole(request.resource.data.role) &&
            request.resource.data.status == 'pending' &&
            get(/databases/$(database)/documents/schools/$(schoolId)).data.isActive == true;
        // A school admin (or, for a school's very first admin — where
        // isSchoolAdmin is impossible, since none is approved yet — a
        // system admin) approves/suspends/rejects a pending member by
        // flipping `status`/`isActive` directly — restricted to just those
        // two fields (plus updatedAt) so an update can't also smuggle in a
        // role change or reassign the doc to a different school.
        // Feature: unified accept/reject UI — `rejectionReason` records why
        // a suspend/reject happened (shown back in the member's own
        // approval history); added to this same allow-list rather than a
        // new rule, since it's still the identical admin-triage action.
        allow update: if (isSchoolAdmin(schoolId) || isSystemAdmin()) &&
            request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'isActive', 'updatedAt', 'rejectionReason']);
        // A member updates their own denormalized display name (kept in
        // sync with users/{uid}.name by ProfileRepository) — restricted to
        // just that field so it can't also touch status/role/schoolId.
        allow update: if isSelf(uid) &&
            request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['displayName', 'updatedAt']);
        allow delete: if false;
      }

      match /parents/{uid} {
        allow read: if isSelf(uid) || isSchoolAdmin(schoolId) || isSystemAdmin();
        allow create, update, delete: if false;
      }

      match /students/{studentId} {
        // A parent needs to read their own child's record (to find its
        // assigned routeId and follow that route's trips), but nothing
        // else about students in the school.
        allow read: if isSchoolAdmin(schoolId) || isSystemAdmin() || isSchoolStaff(schoolId) ||
            isSchoolDriver(schoolId) ||
            (isActiveMember(schoolId) &&
                ('parentIds' in resource.data) &&
                request.auth.uid in resource.data.parentIds);
        allow write: if isSchoolAdmin(schoolId) || isSystemAdmin();
        // A parent can add their own child directly (see
        // StudentsRepository.addChild in the parent app) — always pending
        // admin approval, always listing only themselves as the parent, and
        // never pre-assigned a route/pickup point (that stays admin-only,
        // set once the student is approved).
        allow create: if isActiveMember(schoolId) &&
            request.resource.data.parentIds == [request.auth.uid] &&
            request.resource.data.approved == false &&
            !('routeId' in request.resource.data) &&
            !('latitude' in request.resource.data);
        // A parent marks their own (already-approved) child absent/present
        // for a day — restricted to just that field so they can't also
        // rename the student, unlink themselves, or touch the pickup point.
        // Feature: absence cutoff — gated by isBeforeAbsenceCutoff once the
        // school has configured one; a student with no route or a route
        // with no configured schedule is never gated (nothing to compute
        // the cutoff from).
        allow update: if isActiveMember(schoolId) &&
            resource.data.approved == true &&
            ('parentIds' in resource.data) &&
            request.auth.uid in resource.data.parentIds &&
            request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['absentOn', 'updatedAt']) &&
            isBeforeAbsenceCutoff(schoolId, resource.data.get('routeId', null));
        // A parent schedules future absence dates for their own
        // (already-approved) child — kept as its own rule for the same
        // reason authorizedPickupPersons is: so scheduling a future date
        // can never also smuggle in a same-day absentOn change or vice
        // versa.
        allow update: if isActiveMember(schoolId) &&
            resource.data.approved == true &&
            ('parentIds' in resource.data) &&
            request.auth.uid in resource.data.parentIds &&
            request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['scheduledAbsenceDates', 'updatedAt']);
        // A parent maintains the list of people they've authorized to
        // collect their own (already-approved) child — see
        // StudentsRepository.setAuthorizedPickupPersons in the parent app
        // and AuthorizedPickupPerson in school_shared (Feature: Secure
        // Student Pickup). Kept as its own rule rather than widening the
        // absence rule's allow-list above, so each parent-writable field
        // stays independently scoped: this one can never also flip
        // `absentOn`, and the absence toggle can never rewrite the
        // authorized-pickup list. The list is a record of the parent's own
        // authorization, not an identity check — nothing here grants a
        // named person any access to this system.
        allow update: if isActiveMember(schoolId) &&
            resource.data.approved == true &&
            ('parentIds' in resource.data) &&
            request.auth.uid in resource.data.parentIds &&
            request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['authorizedPickupPersons', 'updatedAt']);
        // Feature: Parent can add child location. A parent proposes a new
        // pickup/drop-off location for their own (already-approved) child
        // — kept as its own field-restricted rule for the same reason as
        // the three above, and deliberately NOT able to touch `latitude`/
        // `longitude` directly: the parent has no authority to make the
        // location official, only to request a change. An admin accepts
        // or rejects it through their own already-unrestricted `write`
        // rule above (accepting copies pending* onto latitude/longitude
        // and clears pending*; rejecting just clears pending*) — see
        // StudentsRepository in the admin app.
        allow update: if isActiveMember(schoolId) &&
            resource.data.approved == true &&
            ('parentIds' in resource.data) &&
            request.auth.uid in resource.data.parentIds &&
            request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  'pendingLatitude', 'pendingLongitude',
                  'pendingLocationRequestedAt', 'updatedAt'
                ]);
      }

      // A durable log of "student X was marked absent on date Y", written
      // alongside the `absentOn` update above (see
      // StudentsRepository.setAbsent in the parent app) — `absentOn`
      // itself only ever holds *today's* value, so this is the only
      // history an admin's attendance report can read. Self-attested and
      // append-only: low sensitivity (just a name + date), no update/delete
      // path, and school-admin-only read access.
      match /absenceLog/{entryId} {
        allow read: if isSchoolAdmin(schoolId) || isSystemAdmin();
        allow create: if isActiveMember(schoolId) &&
            request.resource.data.recordedBy == request.auth.uid;
        allow update, delete: if false;
      }

      // Feature: absence data integrity. The canonical one-per-(student,
      // day) attendance state — see AttendanceRecord in school_shared for
      // why this exists alongside (not instead of) absenceLog above. Doc id
      // is always `${studentId}_${date}`, enforced below, so a parent
      // toggling absent -> present -> absent for the same day merges into
      // the same document instead of appending duplicates the way
      // absenceLog's auto-ids do — that's what makes reporting able to
      // count "was this student absent on this day" instead of "how many
      // absence events fired". A parent may only write their own child's
      // record; a driver (trusted with the full roster already, see
      // isSchoolDriver) or admin may write any student's.
      match /attendanceRecords/{recordId} {
        allow read: if isSchoolAdmin(schoolId) || isSystemAdmin() || isSchoolStaff(schoolId) ||
            (isActiveMember(schoolId) &&
                exists(/databases/$(database)/documents/schools/$(schoolId)/students/$(resource.data.studentId)) &&
                request.auth.uid in get(/databases/$(database)/documents/schools/$(schoolId)/students/$(resource.data.studentId)).data.parentIds);
        allow write: if isActiveMember(schoolId) &&
            request.resource.data.schoolId == schoolId &&
            request.resource.data.updatedBy == request.auth.uid &&
            recordId == request.resource.data.studentId + '_' + request.resource.data.date &&
            (isSchoolAdmin(schoolId) || isSystemAdmin() || isSchoolDriver(schoolId) ||
                (exists(/databases/$(database)/documents/schools/$(schoolId)/students/$(request.resource.data.studentId)) &&
                    request.auth.uid in get(/databases/$(database)/documents/schools/$(schoolId)/students/$(request.resource.data.studentId)).data.parentIds));
        allow delete: if false;
      }

      // A parent's message/request to the school (Feature: Parent–Driver
      // communication). Modeled directly on `absenceLog` above — a
      // self-attested, parent-created record an admin then acts on — with
      // two differences: the parent may read back their *own* entries (so
      // they can see whether the school picked the request up), and an
      // admin may mark one read/closed.
      //
      // The routing is the feature: there is deliberately **no driver read
      // access** here and no rule that would ever give one. A parent writes
      // to the school; the school's admin relays whatever the driver needs.
      // A parent can only ever create an `open` request, for themselves
      // (`parentUid` self-attested exactly like `absenceLog.recordedBy`),
      // in the school the path already names. An admin's update is
      // field-allow-listed to the triage fields so acknowledging a request
      // can never edit the parent's original message.
      match /parentRequests/{requestId} {
        allow read: if isSchoolAdmin(schoolId) || isSystemAdmin() ||
            (isActiveMember(schoolId) && resource.data.parentUid == request.auth.uid);
        allow create: if isActiveMember(schoolId) &&
            request.resource.data.schoolId == schoolId &&
            request.resource.data.parentUid == request.auth.uid &&
            request.resource.data.status == 'open';
        // An admin triages a thread (status/readBy/readAt) OR the two
        // sides keep the "who has unread messages here" flags in sync as
        // the conversation continues (see the messages subcollection
        // below, which is what onParentMessageCreated — functions/src/
        // index.ts — actually flips these from server-side on every new
        // message; a client only ever clears its *own* unread flag when
        // it opens the thread).
        allow update: if (isSchoolAdmin(schoolId) || isSystemAdmin()) &&
            request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'readBy', 'readAt', 'unreadByAdmin']);
        allow update: if isActiveMember(schoolId) &&
            resource.data.parentUid == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['unreadByParent']);
        allow delete: if false;

        // A real back-and-forth conversation on top of the thread above —
        // Feature: Parent-Driver communication, upgraded from one-shot
        // messages to a continuing thread per the school's own request.
        // Never routed to a driver directly (see the thread doc's own
        // comment) — only the parent who owns this thread and this
        // school's admin/system-admin can read or post into it.
        match /messages/{messageId} {
          allow read: if isSchoolAdmin(schoolId) || isSystemAdmin() ||
              (isActiveMember(schoolId) &&
                  get(/databases/$(database)/documents/schools/$(schoolId)/parentRequests/$(requestId)).data.parentUid == request.auth.uid);
          allow create: if isActiveMember(schoolId) &&
              request.resource.data.senderUid == request.auth.uid &&
              ((request.resource.data.senderRole == 'parent' &&
                  get(/databases/$(database)/documents/schools/$(schoolId)/parentRequests/$(requestId)).data.parentUid == request.auth.uid) ||
                  (request.resource.data.senderRole == 'admin' &&
                      (isSchoolAdmin(schoolId) || isSystemAdmin())));
          allow update, delete: if false;
        }
      }

      match /buses/{busId} {
        allow read: if isSchoolAdmin(schoolId) || isSystemAdmin() || isSchoolStaff(schoolId);
        allow write: if isSchoolAdmin(schoolId) || isSystemAdmin();

        // Itemized maintenance/document records (Feature: Vehicle
        // Management) — a bus's own due-date fields (insuranceExpiry etc.)
        // live directly on the bus doc above and are covered by its own
        // write rule; this subcollection is the append-style history of
        // completed/scheduled items behind those dates.
        match /maintenance/{recordId} {
          allow read: if isSchoolAdmin(schoolId) || isSystemAdmin() || isSchoolStaff(schoolId);
          allow write: if isSchoolAdmin(schoolId) || isSystemAdmin();
        }
      }

      match /routes/{routeId} {
        allow read: if isSchoolAdmin(schoolId) || isSystemAdmin() || isSchoolStaff(schoolId);
        // Feature: school location must be set first — see
        // schoolHasLocation. Editing/deactivating an existing route stays
        // unrestricted so this can never lock an admin out of managing
        // what's already there, only out of creating new geography before
        // the school's own endpoint exists.
        allow create: if isSystemAdmin() ||
            (isSchoolAdmin(schoolId) && schoolHasLocation(schoolId));
        allow update, delete: if isSchoolAdmin(schoolId) || isSystemAdmin();

        match /stops/{stopId} {
          allow read, write: if isSchoolAdmin(schoolId) || isSystemAdmin();
        }
      }

      // Admin-defined shared/safe pickup locations (Feature: Smart Pickup
      // Points) — read by any active member (a parent needs to see the
      // point their child is assigned to), written only by an admin.
      match /pickupPoints/{pickupPointId} {
        allow read: if isActiveMember(schoolId) || isSystemAdmin();
        // Feature: school location must be set first — same gate as routes
        // above, same reasoning (a pickup point is operational geography
        // too).
        allow create: if isSystemAdmin() ||
            (isSchoolAdmin(schoolId) && schoolHasLocation(schoolId));
        allow update, delete: if isSchoolAdmin(schoolId) || isSystemAdmin();
      }

      // Operational detail for a driver (Feature: Driver Management) — kept
      // out of the auth-facing `members/{uid}` doc entirely. The driver may
      // read their own; only an admin may write (assign buses/routes, log
      // license/training).
      match /driverProfiles/{uid} {
        allow read: if isSelf(uid) || isSchoolAdmin(schoolId) || isSystemAdmin() || isSchoolStaff(schoolId);
        allow write: if isSchoolAdmin(schoolId) || isSystemAdmin();
      }

      // General incident reports (Feature: Safety/Incident System) —
      // distinct from the per-trip `emergencies` subcollection below (SOS):
      // an incident does not require flipping the trip to
      // TripStatus.emergency, so a driver may file one without that
      // escalation. Only the reporting driver may create; only a school
      // admin may acknowledge/resolve (their own two allowed transitions,
      // one field at a time so a resolve can't also silently edit the
      // original report).
      match /incidents/{incidentId} {
        allow read: if isSchoolAdmin(schoolId) || isSystemAdmin() || isSchoolStaff(schoolId) ||
            (isActiveMember(schoolId) && resource.data.driverId == request.auth.uid);
        allow create: if isActiveMember(schoolId) &&
            request.resource.data.schoolId == schoolId &&
            request.resource.data.driverId == request.auth.uid &&
            request.resource.data.status == 'reported';
        allow update: if (isSchoolAdmin(schoolId) || isSystemAdmin()) &&
            ((resource.data.status == 'reported' &&
                request.resource.data.status == 'acknowledged' &&
                request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['status', 'acknowledgedAt', 'acknowledgedBy'])) ||
                ((resource.data.status == 'reported' || resource.data.status == 'acknowledged') &&
                    request.resource.data.status == 'resolved' &&
                    request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['status', 'resolvedAt', 'resolvedBy', 'resolutionNotes',
                            'acknowledgedAt', 'acknowledgedBy'])));
        allow delete: if false;
      }

      // Route-deviation history (Feature: Route Deviation Detection) —
      // written only by the onDriverLocationWritten Cloud Function via the
      // Admin SDK when a deviation episode closes; never written by a
      // client. Read-only for admins/staff for historical reporting.
      match /routeDeviations/{deviationId} {
        allow read: if isSchoolAdmin(schoolId) || isSystemAdmin() || isSchoolStaff(schoolId);
        allow write: if false;
      }

      // School-wide (or audience-scoped) broadcast messages (Feature: Smart
      // Notifications' "School message" type) — admin-authored, fanned out
      // to a push + inbox entry per matching member by onSchoolMessageCreated
      // (functions/src/index.ts). Never editable/deletable once sent.
      match /messages/{messageId} {
        allow read: if isActiveMember(schoolId) || isSystemAdmin();
        allow create: if isSchoolAdmin(schoolId) &&
            request.resource.data.schoolId == schoolId &&
            request.resource.data.authorId == request.auth.uid;
        allow update, delete: if false;
      }

      // A single immutable, append-only operational audit trail (Feature:
      // Digital Audit Trail) — mirrors the existing trips/{id}/events
      // write-only-subcollection convention, generalized to the whole
      // school instead of one trip. Any active member may create an entry
      // for their own action (`actorUid` must be the caller); nobody may
      // ever update or delete one. Queryable only by admin/staff/system
      // admin, per the feature's own "ordinary users cannot modify audit
      // records" and "queryable by authorized Admin/Staff" requirements.
      match /auditLog/{entryId} {
        allow read: if isSchoolAdmin(schoolId) || isSystemAdmin() || isSchoolStaff(schoolId);
        allow create: if isActiveMember(schoolId) &&
            request.resource.data.schoolId == schoolId &&
            request.resource.data.actorUid == request.auth.uid;
        allow update, delete: if false;
      }

      match /trips/{tripId} {
        // Trip metadata (route/bus/driver names, schedule, status) isn't
        // sensitive, and both the driver assigned to a trip and any parent
        // whose child rides that route need to read it, so read is open to
        // every active member of the school. Creating/editing a trip stays
        // admin-only here; the assigned driver progresses the trip through
        // TripsRepository.updateStatus in the driver app — a direct write
        // (inside a transaction, re-validated there against the same
        // TripStatus.canTransitionTo state machine this mirrors) rather
        // than the dormant updateTripStatus callable, which needed the
        // paid Blaze plan just to let a driver start their own trip.
        allow read: if isActiveMember(schoolId) || isSystemAdmin();
        allow write: if isSchoolAdmin(schoolId) || isSystemAdmin();
        // The assigned driver sets today's pickup order
        // (StopOrderRepository), marks each student boarded, and
        // progresses the trip's own status (start/pause/resume/complete/
        // emergency/cancel, with their respective timestamps) —
        // restricted to just those fields (plus updatedAt) so a driver
        // update can't reassign the trip or edit anything else. A status
        // change is re-validated against the same state machine the
        // dormant callable used to enforce; a boardedStudents change is
        // only allowed while the trip is actually active, so a cancelled
        // or completed trip can't have boarding events added to it via a
        // direct write that bypasses the driver app's own eligibility
        // check (see checkBoardingEligibility in the driver app).
        allow update: if isActiveMember(schoolId) &&
            resource.data.driverId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  'stopOrder', 'boardedStudents', 'droppedOffStudents', 'status',
                  'startedAt', 'completedAt', 'pausedAt', 'resumedAt', 'cancelledAt',
                  'cancelReason', 'updatedAt'
                ]) &&
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
                (isValidTripTransition(resource.data.status, request.resource.data.status) &&
                    (request.resource.data.status != 'starting' ||
                        isWithinTripStartWindow(schoolId, resource.data.scheduledAt)))) &&
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['boardedStudents']) ||
                resource.data.status == 'active') &&
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['droppedOffStudents']) ||
                resource.data.status == 'active');

        // A minimal, write-only event trail (trip started/paused/resumed/
        // completed/cancelled/emergency, a student boarded) — see
        // TripsRepository/StopOrderRepository in the driver app. No admin
        // UI reads this yet (that's a later phase); it exists so that
        // history isn't lost even though the trip document itself only
        // ever keeps the *most recent* pause/resume timestamp.
        match /events/{eventId} {
          allow read: if isSchoolAdmin(schoolId) || isSystemAdmin();
          // The assigned driver stamps their own uid as `driverId` on every
          // event they create (trip status changes, boarding, raising an
          // emergency) — unchanged from before this phase. A school admin
          // resolving an emergency is a new, second kind of actor this
          // subcollection now needs to record; they're never the trip's
          // `driverId`, so that event is keyed by `resolvedBy` instead
          // (self-attested the same way) rather than lying about who they
          // are.
          allow create: if
              (isActiveMember(schoolId) &&
                  get(/databases/$(database)/documents/schools/$(schoolId)/trips/$(tripId))
                      .data.driverId == request.auth.uid &&
                  request.resource.data.driverId == request.auth.uid) ||
              (isSchoolAdmin(schoolId) &&
                  request.resource.data.resolvedBy == request.auth.uid);
          allow update, delete: if false;
        }

        // A structured emergency record (type/location/resolution),
        // separate from the trip's own `status` field (which still just
        // flips to 'emergency' via the update rule above, using the same
        // isValidTripTransition state machine) — see EmergenciesRepository
        // in the driver and admin apps. Only the driver assigned to this
        // trip can raise one, for their own trip, in their own school;
        // only that same driver or this school's admin can resolve it, and
        // only while it's still active. Never deleted, so an emergency's
        // history is never lost even after the trip itself finishes.
        match /emergencies/{emergencyId} {
          allow create: if isActiveMember(schoolId) &&
              get(/databases/$(database)/documents/schools/$(schoolId)/trips/$(tripId))
                  .data.driverId == request.auth.uid &&
              request.resource.data.schoolId == schoolId &&
              request.resource.data.tripId == tripId &&
              request.resource.data.driverId == request.auth.uid &&
              request.resource.data.status == 'active';
          allow update: if resource.data.status == 'active' &&
              request.resource.data.status == 'resolved' &&
              request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['status', 'resolvedAt', 'resolvedBy', 'resolutionNote']) &&
              request.resource.data.resolvedBy == request.auth.uid &&
              (isSchoolAdmin(schoolId) || isSystemAdmin() ||
                  (isActiveMember(schoolId) &&
                      resource.data.driverId == request.auth.uid));
          allow delete: if false;
        }

        // The single *live* deviation record for this trip (Feature: Route
        // Deviation Detection) — written only by the
        // onDriverLocationWritten Cloud Function via the Admin SDK on every
        // GPS update while a deviation episode may be starting/ongoing/
        // ending; never written by a client (a driver/admin cannot self-
        // report "not deviating"). A fixed doc id ('current') is used by
        // convention rather than one per episode — see DeviationRecord.
        match /deviation/{docId} {
          allow read: if isActiveMember(schoolId) || isSystemAdmin();
          allow write: if false;
        }

        // Secure pickup verification (Feature: Secure Student Pickup) — the
        // assigned driver records the outcome of each attempted pickup.
        // Read is open to the trip's driver, this school's admin/staff, and
        // any parent of the specific student the record is about.
        match /pickupVerifications/{verificationId} {
          allow read: if isSchoolAdmin(schoolId) || isSystemAdmin() || isSchoolStaff(schoolId) ||
              (isActiveMember(schoolId) &&
                  (resource.data.driverId == request.auth.uid ||
                      (exists(/databases/$(database)/documents/schools/$(schoolId)/students/$(resource.data.studentId)) &&
                          request.auth.uid in get(/databases/$(database)/documents/schools/$(schoolId)/students/$(resource.data.studentId)).data.parentIds)));
          allow create: if isActiveMember(schoolId) &&
              get(/databases/$(database)/documents/schools/$(schoolId)/trips/$(tripId)).data.driverId == request.auth.uid &&
              request.resource.data.schoolId == schoolId &&
              request.resource.data.tripId == tripId &&
              request.resource.data.driverId == request.auth.uid;
          allow update, delete: if false;
        }

        // Audit-preserving record of a last-minute bus/driver/route change
        // (Feature: Dynamic Route/Last-Minute Changes) — written alongside
        // (never instead of) the admin's own direct update to the trip
        // document's busId/driverId/routeId fields, which the existing
        // unrestricted admin `write` rule on trips already permits.
        match /reassignments/{reassignmentId} {
          allow read: if isSchoolAdmin(schoolId) || isSystemAdmin() || isSchoolStaff(schoolId);
          allow create: if (isSchoolAdmin(schoolId) || isSystemAdmin()) &&
              request.resource.data.schoolId == schoolId &&
              request.resource.data.tripId == tripId &&
              request.resource.data.changedBy == request.auth.uid;
          allow update, delete: if false;
        }

        // Pre/post-trip vehicle inspection checklists (Feature: Vehicle
        // Pre/Post Inspection) — the assigned driver records their own;
        // never editable afterward (a failed/critical inspection is a fact,
        // not something to quietly correct).
        match /inspections/{inspectionId} {
          allow read: if isSchoolAdmin(schoolId) || isSystemAdmin() || isSchoolStaff(schoolId) ||
              (isActiveMember(schoolId) && resource.data.driverId == request.auth.uid);
          allow create: if isActiveMember(schoolId) &&
              get(/databases/$(database)/documents/schools/$(schoolId)/trips/$(tripId)).data.driverId == request.auth.uid &&
              request.resource.data.schoolId == schoolId &&
              request.resource.data.tripId == tripId &&
              request.resource.data.driverId == request.auth.uid;
          allow update, delete: if false;
        }
      }
    }
  }
}
